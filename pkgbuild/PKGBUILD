# Maintainer: BMO <bmo@imaginal.dev>

pkgname=writer
pkgver=0.0.1
pkgrel=1
pkgdesc='Dead-simple Markdown writing app built with Qt Quick'
arch=('x86_64')
url='https://github.com/credimusin/Writer'
license=('MIT')
install='writer.install'
depends=('qt6-base' 'qt6-declarative' 'xdg-desktop-portal')
makedepends=('gcc' 'make' 'qt6-base' 'qt6-declarative')
source=()
sha256sums=()

build() {
  cd "$startdir/.."
  ./bin/build
}

package() {
  cd "$startdir/.."
  /usr/bin/install -Dm755 build/writer "$pkgdir/usr/bin/writer"
  /usr/bin/install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  /usr/bin/install -Dm644 "$startdir/writer.svg" "$pkgdir/usr/share/icons/hicolor/scalable/apps/writer.svg"
  /usr/bin/install -Dm644 "$startdir/writer.desktop" "$pkgdir/usr/share/applications/writer.desktop"
}
